[Unit]
Description=The Birds Business Manager - Backend API
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/birds-business-manager/backend
Environment="NODE_ENV=production"
ExecStart=/usr/bin/node dist/index.js
Restart=on-failure
RestartSec=10
StandardOutput=append:/var/log/birds-backend.log
StandardError=append:/var/log/birds-backend-error.log

[Install]
WantedBy=multi-user.target
